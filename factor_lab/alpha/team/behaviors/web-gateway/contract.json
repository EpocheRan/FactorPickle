{
  "schema": "factor_lab.alpha.behavior_contract.v1",
  "agent": "web-gateway",
  "type": "llm",
  "tier": "L2",
  "inputs": ["discovery_brief", "search_results"],
  "outputs": ["research_question", "leads", "gaps", "sources", "retrieved_at"],
